# Copy this file to ".env" and fill in the key for the provider you use.
# ".env" is gitignored and is read automatically at runtime.
# You only need the ONE key for the provider you choose — delete the rest.
#
# The app also reads these straight from your shell environment, so
# `export ANTHROPIC_API_KEY=...` works just as well as a .env file.

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini (either name works)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Groq
GROQ_API_KEY=

# Mistral
MISTRAL_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Together AI
TOGETHER_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Custom OpenAI-compatible endpoint (use with --provider openai-compatible --base-url ...)
# LLM_API_KEY=

# Ollama (local) needs no key.
